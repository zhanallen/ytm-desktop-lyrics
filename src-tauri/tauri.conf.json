{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ytm-desktop-lyrics",
  "version": "1.1.1",
  "identifier": "com.ytm.desktoplyrics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YT Music Lyrics Widget",
        "width": 280,
        "height": 202,
        "minWidth": 280,
        "minHeight": 86,
        "center": false,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": true,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "偏好設定 - YT Music Lyrics",
        "width": 360,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "url": "index.html?window=settings"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
